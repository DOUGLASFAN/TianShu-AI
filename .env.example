STAR_DATABASE_URL=postgresql+psycopg://xingxu_app:replace-me@127.0.0.1:5432/xingxu
STAR_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
STAR_JWT_SECRET=replace-with-at-least-32-random-characters
STAR_SECURE_COOKIES=false
STAR_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://testserver
# Docker Compose only; local_services.py generates real private values in .env
STAR_DB_PASSWORD=replace-me
STAR_DB_ADMIN_PASSWORD=replace-me-separately
STAR_REDIS_PASSWORD=replace-me

# Progressive maps: auto uses public Esri when no Tianditu key is configured.
# Keep real keys in private .env. Baidu AK cannot replace a Tianditu key.
STAR_MAP_PROVIDER=auto
# STAR_TIANDITU_KEY=
# STAR_ARCGIS_TOKEN=
